        "medium": "Area 400-800 pixels, noticeable discoloration",
        "high": "Area > 800 pixels, severe color deviation"
      },
      "color_marker": "Blue (BGR: 255, 0, 0)"
    },
    "missing_component": {
      "detection_method": "Binary thresholding with morphological closing to detect voids",
      "characteristics": "Compact regions with aspect ratio 0.5-2.0 representing missing parts",
      "severity_criteria": {
        "low": "Area < 500 pixels, small missing parts",
        "medium": "Area 500-1000 pixels, noticeable missing components",
